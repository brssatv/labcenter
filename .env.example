PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-64-char-random-secret
# Optional: set the public app origin used for OIDC redirect/logout URLs in production.
# APP_BASE_URL=https://portal.example.com
# Optional: enable admin SSO with Keycloak or another OIDC provider.
# OIDC_ISSUER=https://idp.example.com/realms/labcenter
# OIDC_CLIENT_ID=labcenter_portal
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email
# OIDC_REDIRECT_URI=https://portal.example.com/auth/oidc/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=https://portal.example.com/
# Optional: require a specific IdP role before granting LabCenter admin access.
# OIDC_REQUIRED_ROLE=labcenter_admin
# Optional: point writable runtime data at a different folder or mounted disk.
# DATA_DIR=./runtime-data
# SESSION_DIR=./runtime-data/sessions
# Optional: native helpers default to enabled on macOS and disabled elsewhere.
# LABCENTER_ENABLE_REPORT_PDF=true
# LABCENTER_ENABLE_SCAN_OCR=true
# Optional: enable S3 storage for uploaded raw files and generated PDFs.
# LABCENTER_S3_BUCKET=your-private-bucket
# LABCENTER_S3_REGION=us-east-1
# LABCENTER_S3_PREFIX=labcenter
# LABCENTER_S3_ENDPOINT=
# LABCENTER_S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional: PharmD SFTP delivery settings.
# PHARMD_SFTP_HOST=18.144.129.54
# PHARMD_SFTP_PORT=22
# PHARMD_SFTP_USERNAME=jays-user
# PHARMD_SFTP_PASSWORD=
# PHARMD_SFTP_ORU_DIR=oru
# PHARMD_SFTP_PDF_DIR=pharmd-pdf2
# PHARMD_SFTP_TIMEOUT_SEC=30
# PHARMD_SFTP_RECEIPT_INTERVAL_SEC=1200
# PHARMD_SFTP_RECEIPT_MAX_CHECKS=5
