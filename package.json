{
  "name": "labcenter-secure-portal",
  "version": "1.0.0",
  "private": true,
  "description": "LabCenter secure login portal scaffold",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "hash-password": "node scripts/hash-password.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:win-portable": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@napi-rs/canvas": "^0.1.97",
    "@tesseract.js-data/eng": "^1.0.0",
    "ag-grid-community": "^35.2.1",
    "better-sqlite3": "^12.8.0",
    "canvas": "^3.2.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "session-file-store": "^1.5.0",
    "tesseract.js": "^7.0.0",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.innovexlab.labcenter",
    "productName": "LabCenter",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build-resources"
    },
    "files": [
      "app.js",
      "electron-main.js",
      "index.html",
      "styles.css",
      "server.js",
      "lib/**/*",
      "assets/**/*",
      "data/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LabCenter"
    }
  }
}
